      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response Status is 200 and Message is Success\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.Status).to.eql(200);\r\n    pm.expect(jsonData.Message).to.eql(\"Success\");\r\n});\r\n\r\npm.test(\"Leads list includes test customer Pandu_2 or pandu\", function () {\r\n    const jsonData = pm.response.json();\r\n    const leads = (jsonData.data && jsonData.data.Leads) || [];\r\n    const found = leads.some(\r\n        (lead) => lead.LeadName === \"Pandu_2\" || lead.LeadName === \"pandu\"\r\n    );\r\n    pm.expect(found).to.be.true;\r\n});"
            ]
          }
        }
